  // --- SURVEY MANAGEMENT ---
  let selectedSurveyCategory = "";
  let currentCandyRating = 0;

  function initSurveyLogic() {
    const form = document.getElementById("survey-form");
    if (!form) return;

    // Chọn danh mục yêu thích (Câu 1)
    const catOpts = document.querySelectorAll(".survey-cat-opt");
    catOpts.forEach(btn => {
      btn.addEventListener("click", () => {
        catOpts.forEach(o => {
          o.classList.remove("bg-[#2d2319]", "text-white");
          o.classList.add("bg-white", "text-[#2d2319]");
        });
        btn.classList.remove("bg-white", "text-[#2d2319]");
        btn.classList.add("bg-[#2d2319]", "text-white");
        selectedSurveyCategory = btn.getAttribute("data-value") || "";
        const input = document.getElementById("survey-favorite-category");
        if (input) input.value = selectedSurveyCategory;
      });
    });

    // Chọn đánh giá bằng kẹo sữa (Câu 2)
    const ratingStars = document.querySelectorAll(".candy-star");
    const ratingVal = document.getElementById("survey-rating-value");
    const ratingDesc = document.getElementById("rating-desc");

    const descs = {
      1: "🍬 1 kẹo: Dịch vụ còn kém, tiệm cần cải thiện nhiều 🥺",
      2: "🍬🍬 2 kẹo: Tạm ổn thôi, chưa ấn tượng lắm 😐",
      3: "🍬🍬🍬 3 kẹo: Khá tốt nha, tiệm dễ thương 🙂",
      4: "🍬🍬🍬🍬 4 kẹo: Rất mến tiệm, đồ ăn vặt ngon tuyệt 😍",
      5: "🍬🍬🍬🍬🍬 5 kẹo: Tuyệt vời ông mặt trời, sẽ ủng hộ dài dài! 🥰"
    };

    ratingStars.forEach(star => {
      star.addEventListener("click", () => {
        const rating = parseInt(star.getAttribute("data-rating") || "0");
        currentCandyRating = rating;
        if (ratingVal) ratingVal.value = String(rating);

        // Đổi trạng thái grayscale
        ratingStars.forEach(s => {
          const r = parseInt(s.getAttribute("data-rating") || "0");
          if (r <= rating) {
            s.classList.remove("grayscale");
          } else {
            s.classList.add("grayscale");
          }
        });

        if (ratingDesc && descs[rating]) {
          ratingDesc.innerText = descs[rating];
          ratingDesc.className = "text-xs font-sans text-red-600 font-bold animate-pulse";
        }
      });
    });

    // Gửi khảo sát
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const nameInput = document.getElementById("survey-name");
      const emailInput = document.getElementById("survey-email");
      const improvementInput = document.getElementById("survey-improvement");
      const submitBtn = document.getElementById("submit-survey-btn");

      if (!nameInput || !emailInput || !improvementInput || !submitBtn) return;

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const improvement = improvementInput.value.trim();

      if (!name) {
        showToast("Vui lòng điền Họ tên của bạn nha!", "warning");
        nameInput.focus();
        return;
      }

      if (!email) {
        showToast("Vui lòng điền Email của bạn nha!", "warning");
        emailInput.focus();
        return;
      }

      if (!selectedSurveyCategory) {
        showToast("Hãy chọn 1 nhóm sản phẩm bạn mê nhất ở Câu 1 nha!", "warning");
        return;
      }

      if (currentCandyRating === 0) {
        showToast("Vui lòng chấm điểm kẹo sữa ở Câu 2 giúp tiệm nha!", "warning");
        return;
      }

      // Trạng thái loading cho nút bấm
      submitBtn.disabled = true;
      submitBtn.classList.add("opacity-75", "cursor-wait");
      const originalBtnText = submitBtn.innerHTML;
      submitBtn.innerText = "📮 Đang gửi ý kiến đến tiệm...";

      const responses = {
        favorite_category: selectedSurveyCategory,
        satisfaction_stars: currentCandyRating,
        improvement_suggestions: improvement
      };

      const result = await submitSurveyToSupabase({
        name,
        email,
        responses
      });

      if (result.success) {
        showToast(`🎉 Cảm ơn bạn! Ý kiến đã được tiệm ghi nhận thành công! ${result.isSimulated ? '(Chế độ giả lập)' : '(Đã lưu vào Supabase)'}`, "success");
        
        // Reset form
        form.reset();
        selectedSurveyCategory = "";
        currentCandyRating = 0;
        if (ratingVal) ratingVal.value = "0";

        // Khôi phục UI cat options
        catOpts.forEach(o => {
          o.classList.remove("bg-[#2d2319]", "text-white");
          o.classList.add("bg-white", "text-[#2d2319]");
        });

        // Khôi phục UI kẹo sữa đánh giá
        ratingStars.forEach(s => s.classList.add("grayscale"));
        if (ratingDesc) {
          ratingDesc.innerText = "Bấm chọn số kẹo sữa để đánh giá (1-5 kẹo)";
          ratingDesc.className = "text-xs text-gray-500 font-sans italic";
        }

        // Reset nút bấm
        submitBtn.disabled = false;
        submitBtn.classList.remove("opacity-75", "cursor-wait");
        submitBtn.innerHTML = originalBtnText;

      } else {
        showToast(`Lỗi khi gửi góp ý: ${result.error || 'Vui lòng thử lại sau!'}`, "warning");
        submitBtn.disabled = false;
        submitBtn.classList.remove("opacity-75", "cursor-wait");
        submitBtn.innerHTML = originalBtnText;
      }
    });
  }

  // --- THIẾT LẬP PHỤ TRỢ (TOAST & FEEDBACK) ---
  function showToast(message, type = "info") {
    const container = document.getElementById("toast-container");
    if (!container) return;
    const toast = document.createElement("div");

    let bg = "bg-neutral-950 text-white";
    let icon = "fa-info-circle";

    if (type === "success") {
      bg = "bg-emerald-800 text-white";
      icon = "fa-check-circle";
    } else if (type === "warning") {
      bg = "bg-amber-600 text-white";
      icon = "fa-exclamation-triangle";
    }

    toast.className = `${bg} p-4 rounded-lg shadow-lg flex items-center gap-3 text-xs sm:text-sm font-bold border-2 border-[#2d2319] transition-all duration-300 transform translate-y-2 opacity-0`;
    toast.innerHTML = `
      <i class="fa-solid ${icon} text-lg"></i>
      <span>${message}</span>
    `;

    container.appendChild(toast);

    setTimeout(() => {
      toast.classList.remove("translate-y-2", "opacity-0");
    }, 10);

    setTimeout(() => {
      toast.classList.add("translate-y-2", "opacity-0");
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

