---
import Layout from '../layouts/Layout.astro';
import { fetchProducts } from '../lib/productsStore';

// Lấy sản phẩm từ Server-Side (Supabase / Fallback) để tối ưu SEO và tốc độ tải trang ban đầu
const serverProducts = await fetchProducts();
---

<Layout title="Tiệm Tạp Hóa - Tiện Lợi & Thân Thuộc">
  <!-- Thanh điều hướng phía trên -->
  <header class="bg-[#2d2319] text-[#f7f3e9] sticky top-0 z-40 border-b-4 border-[#e07a5f]">
    <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
      <a href="#" class="flex items-center gap-2">
        <span class="font-retro font-bold text-xl tracking-wide text-[#f4a261]">Tạp Hóa Tuổi Thơ</span>
      </a>

      <nav class="hidden md:flex items-center gap-6 font-medium text-sm">
        <a href="#danh-muc" class="hover:text-[#f4a261] transition-colors">Gian Hàng</a>
        <a href="#do-so-keo" class="hover:text-[#f4a261] transition-colors">Dò Số Trúng Kẹo</a>
        <a href="#lien-he" class="hover:text-[#f4a261] transition-colors">Liên Hệ</a>
      </nav>

      <div class="flex items-center gap-4">
        <!-- Nút Giỏ hàng -->
        <button
          id="cart-btn"
          class="relative bg-[#f4a261] hover:bg-[#e76f51] text-[#2d2319] px-4 py-2 rounded-md font-bold transition-all flex items-center gap-2 retro-shadow-sm border-2 border-[#2d2319]"
        >
          <i class="fa-solid fa-basket-shopping text-lg"></i>
          <span class="hidden sm:inline">Giỏ Đồ</span>
          <span
            id="cart-count-badge"
            class="bg-red-600 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center border border-[#2d2319]"
            >0</span
          >
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Section: Mặt tiền tiệm tạp hóa -->
  <section class="relative bg-[#e9d8a6] pt-12 pb-16 px-4 border-b-8 border-[#2d2319]">
    <!-- Mái hiên di động kẻ sọc đỏ trắng phía trên -->
    <div class="absolute top-0 left-0 w-full h-8 awning-stripe shadow-md border-b-4 border-[#2d2319]"></div>

    <div class="max-w-5xl mx-auto mt-4 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Biển hiệu tạp hóa thân thuộc -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-block bg-[#de3e3e] text-white px-3 py-1 text-xs font-bold uppercase tracking-widest rounded retro-border shadow-sm mb-2">
          Tiệm Tạp Hóa Thân Thuộc Gần Nhà
        </div>
        <h1 class="font-retro text-4xl sm:text-6xl font-extrabold text-[#2d2319] leading-tight">
          Tiệm <br />
          <span class="text-[#e07a5f]">Tạp Hóa</span> Thân Thuộc!
        </h1>
        <p class="text-base sm:text-lg text-[#4a3f35] font-medium max-w-xl leading-relaxed">
          Nơi cung cấp đầy đủ các loại bánh kẹo ăn vặt ngon miệng, mì gói tiện lợi, nước giải khát mát lạnh và gia vị thiết thực cho gian bếp của bạn. Giá cả bình dân, phục vụ chu đáo và nhanh chóng mỗi ngày!
        </p>

        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="#danh-muc"
            class="bg-[#e07a5f] hover:bg-[#f4a261] text-[#2d2319] px-6 py-3 rounded font-bold text-lg retro-border retro-shadow transition-all transform hover:-translate-y-1 inline-block"
          >
            🛒 Vào Tiệm Lựa Đồ
          </a>
          <a
            href="#do-so-keo"
            class="bg-[#3d5a80] hover:bg-[#293241] text-white px-6 py-3 rounded font-bold text-lg retro-border retro-shadow transition-all transform hover:-translate-y-1 inline-block"
          >
            🍬 Mua Kẹo Sữa Dò Số May Mắn
          </a>
        </div>
      </div>

      <!-- Thiết kế storefront mini bằng CSS -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-[360px] bg-[#dda15e] rounded-xl retro-border retro-shadow p-6 flex flex-col justify-between aspect-[4/5]">
          <!-- Biển hiệu gỗ treo -->
          <div class="bg-[#2d2319] text-[#f7f3e9] text-center py-2 px-4 rounded border-2 border-[#e9d8a6] mb-4">
            <span class="font-retro text-xs uppercase tracking-widest text-[#f4a261]">Bán Đủ Thứ</span>
            <h3 class="font-retro text-xl font-bold">KẸO • MÌ GÓI • GIA VỊ</h3>
          </div>

          <!-- Quầy kệ mô phỏng -->
          <div class="flex-1 grid grid-cols-3 gap-3 bg-[#be8a51] p-3 rounded-lg border-2 border-[#2d2319] relative overflow-hidden">
            <!-- Đèn sợi đốt treo tỏa sáng -->
            <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-4 h-4 bg-yellow-300 rounded-full animate-pulse shadow-[0_0_15px_rgba(253,224,71,1)]"></div>

            <!-- Kệ 1: Bánh kẹo -->
            <div class="bg-[#9c6a38] p-1.5 rounded flex flex-col justify-around items-center border border-[#2d2319]">
              <!-- SVG Minh Họa Kẹo Sữa Sumika Nhỏ -->
              <svg class="w-10 h-6" viewBox="0 0 120 70" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 10 L10 15 L0 20 L10 25 L0 30 L10 35 L0 40 L10 45 L0 50 L10 55 L0 60 L15 60 L15 10 Z" fill="#15803d" />
                <path d="M120 10 L110 15 L120 20 L110 25 L120 30 L110 35 L120 40 L110 45 L120 50 L110 55 L120 60 L105 60 L105 10 Z" fill="#15803d" />
                <rect x="14" y="10" width="92" height="50" fill="white" stroke="#15803d" stroke-width="2" />
                <path d="M14 45 Q50 35 106 48 L106 60 L14 60 Z" fill="#22c55e" />
                <text x="24" y="32" font-family="'Playfair Display', serif" font-weight="900" font-size="12" fill="#1d4ed8">SUMiKA</text>
                <text x="26" y="42" font-family="'Patrick Hand', cursive" font-weight="bold" font-size="10" fill="#16a34a">Sữa</text>
              </svg>
              <span class="text-[9px] font-bold text-[#f7f3e9] uppercase bg-red-700 px-1 rounded">Sumika</span>
            </div>
            <!-- Kệ 2: Nước uống -->
            <div class="bg-[#9c6a38] p-1.5 rounded flex flex-col justify-around items-center border border-[#2d2319]">
              <span class="text-2xl">🥤</span>
              <span class="text-[9px] font-bold text-[#f7f3e9] uppercase bg-blue-700 px-1 rounded">Giải Khát</span>
            </div>
            <!-- Kệ 3: Gia vị -->
            <div class="bg-[#9c6a38] p-1.5 rounded flex flex-col justify-around items-center border border-[#2d2319]">
              <span class="text-2xl">🧂</span>
              <span class="text-[9px] font-bold text-[#f7f3e9] uppercase bg-emerald-700 px-1 rounded">Gia Vị</span>
            </div>
            <!-- Kệ 4: Mì gói -->
            <div class="bg-[#9c6a38] p-1.5 rounded flex flex-col justify-around items-center border border-[#2d2319] col-span-3">
              <div class="flex gap-4 items-center">
                <span class="text-2xl">🍜</span>
                <span class="text-xs font-bold text-[#f7f3e9] uppercase">Mì tôm 2 con tôm</span>
              </div>
            </div>
          </div>

          <!-- Biển mở cửa -->
          <div class="mt-4 flex justify-between items-center bg-[#be8a51] p-2 rounded border border-[#2d2319]">
            <span class="text-xs font-bold text-[#2d2319] flex items-center gap-1">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block animate-ping"></span>
              Đang mở cửa
            </span>
            <span class="text-xs font-bold text-red-800 bg-yellow-200 px-2 py-0.5 rounded">Từ 6g - 21g</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Gian Hàng Sản Phẩm -->
  <section id="danh-muc" class="py-16 px-4 max-w-6xl mx-auto">
    <div class="text-center space-y-4 mb-12">
      <span class="text-sm uppercase tracking-wider font-bold text-[#e07a5f]">Hôm nay nhà mình có gì?</span>
      <h2 class="font-retro text-4xl font-extrabold text-[#2d2319]">Ghé Lựa Đồ!</h2>
      <p class="text-[#6f5e4c] max-w-lg mx-auto">
        Click chọn danh mục để tìm nhanh các loại bánh kẹo ngọt lành, mì gói ăn liền ấm bụng, nước giải khát mát lạnh hay gia vị đậm đà cho gian bếp nhé.
      </p>
    </div>

    <!-- Bộ Lọc Danh Mục -->
    <div class="flex flex-wrap justify-center gap-2 mb-10">
      <button
        id="btn-cat-tat-ca"
        data-cat="tat-ca"
        class="cat-btn active bg-[#2d2319] text-[#f7f3e9] px-4 py-2 rounded-full font-bold border-2 border-[#2d2319] transition-all"
      >
        🌟 Tất cả
      </button>
      <button
        id="btn-cat-banh-keo"
        data-cat="banh-keo"
        class="cat-btn bg-white text-[#2d2319] px-4 py-2 rounded-full font-bold border-2 border-[#2d2319] hover:bg-[#2d2319] hover:text-[#f7f3e9] transition-all"
      >
        🍬 Bánh & Kẹo
      </button>
      <button
        id="btn-cat-nuoc-uong"
        data-cat="nuoc-uong"
        class="cat-btn bg-white text-[#2d2319] px-4 py-2 rounded-full font-bold border-2 border-[#2d2319] hover:bg-[#2d2319] hover:text-[#f7f3e9] transition-all"
      >
        🥤 Nước Giải Khát
      </button>
      <button
        id="btn-cat-mi-goi"
        data-cat="mi-goi"
        class="cat-btn bg-white text-[#2d2319] px-4 py-2 rounded-full font-bold border-2 border-[#2d2319] hover:bg-[#2d2319] hover:text-[#f7f3e9] transition-all"
      >
        🍜 Mì Ăn Liền
      </button>
      <button
        id="btn-cat-gia-vi"
        data-cat="gia-vi"
        class="cat-btn bg-white text-[#2d2319] px-4 py-2 rounded-full font-bold border-2 border-[#2d2319] hover:bg-[#2d2319] hover:text-[#f7f3e9] transition-all"
      >
        🧂 Gia Vị Nhà Bếp
      </button>
    </div>

    <!-- Danh sách Sản Phẩm -->
    <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <!-- Render động bằng JS từ Dữ liệu Server-side -->
    </div>
  </section>

  <!-- Section: Trò Chơi Mua Kẹo Sữa Dò Số May Mắn -->
  <section id="do-so-keo" class="py-16 px-4 bg-[#e9d8a6] border-y-4 border-[#2d2319]">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <!-- Cột trái: Thông tin trò chơi & Bảng Phấn Giải Thưởng -->
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 bg-[#15803d] text-white px-3 py-1 text-xs font-bold uppercase rounded border-2 border-[#2d2319] shadow-sm">
          🥛 Trò Chơi Bóc Số Trúng Quà SUMiKA
        </div>
        <h2 class="font-retro text-3xl sm:text-4xl font-extrabold text-[#2d2319] leading-tight">
          Mua Kẹo Sữa SUMiKA <br />
          Bóc Vỏ Dò Số Trúng Quà!
        </h2>
        <p class="text-[#4a3f35] font-medium leading-relaxed">
          Trải nghiệm trò chơi bốc kẹo sữa **SUMiKA** nhận mã số may mắn! Mỗi cây kẹo sữa mềm béo ngậy, ngọt ngào đặc trưng sẽ đi kèm một con số ngẫu nhiên dưới lớp vỏ giấy gói màu xanh lá. Hãy bóc vỏ kẹo và so khớp mã số trực tiếp với bảng kết quả bên dưới để nhận ngay các phần quà hấp dẫn đi kèm hóa đơn nhé!
        </p>

        <!-- Bảng phấn giải thưởng kiểu retro -->
        <div class="bg-[#1e2e22] text-[#f1ebd9] p-5 rounded-lg border-4 border-[#4a3f35] shadow-lg relative font-mono">
          <!-- Viền vân gỗ bảng đen -->
          <div class="absolute -inset-1 border border-[#3e2723] rounded pointer-events-none"></div>
          <h3 class="text-center font-bold text-lg text-yellow-300 border-b border-dashed border-[#f1ebd9]/30 pb-2 mb-3">
            📋 BẢNG GIẢI THƯỞNG HÔM NAY
          </h3>
          <ul class="text-xs space-y-2.5">
            <li class="flex justify-between items-center">
              <span class="text-red-400 font-bold">⭐ GIẢI ĐẶC BIỆT (Số 88):</span>
              <span class="text-yellow-200">Tặng 1 Gói Kẹo Sữa SUMiKA (350g)</span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-orange-300 font-bold">🥇 GIẢI NHẤT (Số 12 hoặc 45):</span>
              <span class="text-yellow-100">Tặng 1 Lon Sá Xị Chương Dương</span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-teal-300">🥈 GIẢI NHÌ (Số 07, 33, 67, 91):</span>
              <span class="text-yellow-500/90">Tặng 1 Gói Mì Giấy Miliket</span>
            </li>
            <li class="flex justify-between items-center">
              <span class="text-gray-400">🥉 GIẢI KHUYẾN KHÍCH (Đuôi 5 hoặc 9):</span>
              <span>Tặng 2 Viên Kẹo Sữa SUMiKA lẻ</span>
            </li>
          </ul>
          <p class="text-[10px] text-gray-400 mt-4 text-center italic">
            * Quà trúng thưởng sẽ được đính kèm trực tiếp vào hóa đơn của bạn hoàn toàn miễn phí.
          </p>
        </div>
      </div>

      <!-- Cột phải: Khu vực Tương tác Bóc Kẹo -->
      <div class="flex flex-col items-center justify-center">
        <div class="w-full max-w-[320px] bg-[#fcfbf9] rounded-xl border-4 border-[#2d2319] p-6 retro-shadow flex flex-col items-center gap-6 relative">
          <!-- Decor Hũ Thủy Tinh Kẹo Sữa SUMiKA -->
          <div class="text-center">
            <span class="text-xs font-bold text-[#15803d] uppercase tracking-widest block mb-1">Hũ kẹo sữa SUMiKA</span>

            <!-- Thiết kế hũ thủy tinh tinh xảo chứa kẹo -->
            <div id="candy-jar" class="w-24 h-24 bg-sky-50/60 rounded-t-3xl rounded-b-lg border-2 border-[#2d2319] shadow-inner flex flex-wrap justify-center items-center p-2 pt-5 relative overflow-hidden transition-all duration-300">
              <!-- Nắp hũ đỏ -->
              <div class="absolute top-0 left-0 right-0 h-4 bg-red-600 border-b-2 border-[#2d2319]"></div>
              <!-- Nhãn hũ kẹo -->
              <div class="absolute bottom-2 left-1/2 -translate-x-1/2 bg-white/90 px-1 border border-emerald-700 text-[8px] font-bold text-blue-800 rounded">
                SUMiKA
              </div>

              <!-- Kẹo SUMiKA nhỏ bên trong -->
              <div class="opacity-80 scale-75 transform -rotate-12">
                <svg class="w-8 h-4" viewBox="0 0 120 70" fill="none">
                  <path d="M0 10 L10 15 L0 20 L10 25 L0 30 L10 35 L0 40 L10 45 L0 50 L10 55 L0 60 L15 60 L15 10 Z" fill="#15803d" />
                  <path d="M120 10 L110 15 L120 20 L110 25 L120 30 L110 35 L120 40 L110 45 L120 50 L110 55 L120 60 L105 60 L105 10 Z" fill="#15803d" />
                  <rect x="14" y="10" width="92" height="50" fill="white" stroke="#15803d" stroke-width="2" />
                  <path d="M14 45 Q50 35 106 48 L106 60 L14 60 Z" fill="#22c55e" />
                </svg>
              </div>
              <div class="opacity-90 scale-75 transform rotate-45">
                <svg class="w-8 h-4" viewBox="0 0 120 70" fill="none">
                  <path d="M0 10 L10 15 L0 20 L10 25 L0 30 L10 35 L0 40 L10 45 L0 50 L10 55 L0 60 L15 60 L15 10 Z" fill="#15803d" />
                  <path d="M120 10 L110 15 L120 20 L110 25 L120 30 L110 35 L120 40 L110 45 L120 50 L110 55 L120 60 L105 60 L105 10 Z" fill="#15803d" />
                  <rect x="14" y="10" width="92" height="50" fill="white" stroke="#15803d" stroke-width="2" />
                  <path d="M14 45 Q50 35 106 48 L106 60 L14 60 Z" fill="#22c55e" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Mảnh Giấy Kết Quả Ẩn/Hiện kẹo sữa mềm -->
          <div id="candy-wrapper-area" class="w-full h-40 bg-[#f1ebd9] rounded-lg border-2 border-dashed border-[#2d2319] flex flex-col justify-center items-center p-4 relative overflow-hidden">
            <!-- Trạng thái mặc định -->
            <div id="candy-hidden" class="text-center space-y-2 flex flex-col items-center">
              <!-- SVG gói kẹo SUMiKA may mắn nhảy nhảy -->
              <div class="animate-bounce mb-1">
                <svg class="w-20 h-10" viewBox="0 0 120 70" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0 10 L10 15 L0 20 L10 25 L0 30 L10 35 L0 40 L10 45 L0 50 L10 55 L0 60 L15 60 L15 10 Z" fill="#15803d" />
                  <path d="M120 10 L110 15 L120 20 L110 25 L120 30 L110 35 L120 40 L110 45 L120 50 L110 55 L120 60 L105 60 L105 10 Z" fill="#15803d" />
                  <rect x="14" y="10" width="92" height="50" fill="white" stroke="#15803d" stroke-width="2" />
                  <path d="M14 45 Q50 35 106 48 L106 60 L14 60 Z" fill="#22c55e" />
                  <!-- Mặt bò sữa dễ thương -->
                  <circle cx="85" cy="32" r="10" fill="#f5f5f5" stroke="#2d2319" stroke-width="1" />
                  <ellipse cx="85" cy="36" r="7" fill="#fbcfe8" />
                  <circle cx="83" cy="30" r="1.5" fill="black" />
                  <circle cx="87" cy="30" r="1.5" fill="black" />
                  <path d="M78 24 Q85 21 86 26" stroke="black" stroke-width="1.5" fill="none" />
                  <path d="M92 24 Q85 21 84 26" stroke="black" stroke-width="1.5" fill="none" />
                  <text x="20" y="32" font-family="'Playfair Display', serif" font-weight="900" font-size="11" fill="#1d4ed8">SUMiKA</text>
                  <text x="22" y="42" font-family="'Patrick Hand', cursive" font-weight="bold" font-size="10" fill="#16a34a">Sữa</text>
                </svg>
              </div>
              <p class="text-xs font-bold text-emerald-900">Kẹo Sữa SUMiKA May Mắn</p>
              <p class="text-[10px] text-gray-500">Mở vỏ kẹo nhận ngay mã số dò thưởng!</p>
            </div>

            <!-- Trạng thái bóc kẹo (Hiện số cùng vỏ gói kẹo và viên kẹo sữa mềm) -->
            <div id="candy-revealed" class="hidden text-center w-full flex flex-col items-center justify-center">
              <div class="flex items-center gap-4 justify-center animate-fade-in mb-1">
                <!-- Vỏ kẹo SUMiKA rách một bên -->
                <div class="transform -rotate-12 opacity-80">
                  <svg class="w-16 h-8" viewBox="0 0 120 70" fill="none">
                    <path d="M0 10 L10 15 L0 20 L10 25 L0 30 L10 35 L0 40 L10 45 L0 50 L10 55 L0 60 L15 60 L15 10 Z" fill="#15803d" />
                    <path d="M90 10 L85 15 L90 20 L80 35 L90 50 L85 60 L75 60 L75 10 Z" fill="#15803d" />
                    <rect x="14" y="10" width="62" height="50" fill="white" stroke="#15803d" stroke-width="2" />
                    <path d="M14 45 Q50 35 76 48 L76 60 L14 60 Z" fill="#22c55e" />
                    <text x="18" y="32" font-family="'Playfair Display', serif" font-weight="900" font-size="9" fill="#1d4ed8">SUMiKA</text>
                  </svg>
                </div>
                <!-- Viên kẹo sữa mềm màu trắng kem -->
                <div class="relative transform rotate-6">
                  <svg class="w-16 h-10" viewBox="0 0 60 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <ellipse cx="30" cy="26" rx="22" ry="7" fill="#000000" fill-opacity="0.12" />
                    <rect x="8" y="6" width="44" height="24" rx="10" fill="#fefaf0" stroke="#c5a880" stroke-width="2" />
                    <path d="M12 14 Q30 11 48 14" stroke="white" stroke-width="1.5" fill="none" />
                  </svg>
                  <!-- Số may mắn nổi bật phía trên viên kẹo -->
                  <span id="revealed-number" class="absolute inset-0 flex items-center justify-center text-xl font-black text-red-600 font-sans tracking-wide pt-1">--</span>
                </div>
              </div>
              <p id="revealed-match-status" class="text-xs font-bold text-emerald-800 mt-1">Đang kiểm tra kết quả...</p>
            </div>
          </div>

          <!-- Nút mua kẹo bóc số -->
          <button
            id="buy-candy-btn"
            class="w-full bg-[#15803d] hover:bg-[#166534] text-white font-bold py-3 px-4 rounded-lg border-2 border-[#2d2319] retro-shadow-sm transition-transform active:scale-95 flex items-center justify-center gap-2"
          >
            <span>🥛 Bóc Kẹo Sữa (1.000đ/viên)</span>
          </button>
        </div>

        <!-- Mô tả kết quả ở chân trò chơi -->
        <div id="candy-game-toast" class="mt-4 text-center h-8">
          <p class="text-xs text-gray-500 italic">Bấm nút mua kẹo, số tiền kẹo (1.000đ/viên) sẽ tự động cộng vào hóa đơn của bạn.</p>
        </div>
      </div>
    </div>
  </section>

