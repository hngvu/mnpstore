    </div>

    <!-- Vùng tin nhắn -->
    <div id="chatbot-messages" class="flex-1 overflow-y-auto p-3 space-y-3 scroll-smooth"></div>

    <!-- Quick replies -->
    <div id="chatbot-quick-replies" class="px-3 pb-2 flex flex-wrap gap-1.5 shrink-0"></div>

    <!-- Ô nhập -->
    <div class="p-3 bg-[#f1ebd9] border-t-2 border-[#2d2319] flex gap-2 shrink-0">
      <input
        id="chatbot-input"
        type="text"
        placeholder="Nhập tin nhắn..."
        class="flex-1 bg-white border-2 border-[#2d2319] rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-[#e07a5f] font-sans"
        autocomplete="off"
      />
      <button id="chatbot-send" class="bg-[#e07a5f] hover:bg-[#de3e3e] text-white w-10 h-10 rounded-lg flex items-center justify-center border-2 border-[#2d2319] transition-all active:scale-90">
        <i class="fa-solid fa-paper-plane"></i>
      </button>
    </div>
  </div>
</Layout>

<script>
  import { fetchProducts, submitOrderToSupabase, submitSurveyToSupabase } from '../lib/productsStore';

  // State cục bộ của trang
  let products = [];
  let cart = [];
  let purchasedCandyCount = 0;
  let activeDiscount = null;
  let isOpeningCandy = false;

  // Đọc dữ liệu từ server prefetch truyền sang
  const dataEl = document.getElementById('server-products-data');
  if (dataEl) {
    try {
      products = JSON.parse(dataEl.getAttribute('data-products') || '[]');
    } catch (e) {
      console.error("Lỗi khi giải nén dữ liệu sản phẩm:", e);
    }
  }

  // Định dạng tiền tệ Việt Nam
  function formatVND(amount) {
    return amount.toLocaleString("vi-VN") + "đ";
  }

  // --- RENDERING PRODUCTS ---
  function renderProducts(category) {
    const grid = document.getElementById('product-grid');
    if (!grid) return;
    grid.innerHTML = "";

    const filtered = category === "tat-ca"
      ? products
      : products.filter(p => p.category === category);

    filtered.forEach(p => {
      const card = document.createElement("div");
      card.className = "bg-[#fcfbf9] rounded-lg p-4 retro-border retro-shadow-sm flex flex-col justify-between hover:scale-[1.02] transition-transform duration-200";

      // Vẽ ảnh đại diện SVG đặc biệt cho gói Kẹo Sữa Sumika
      let imageBlock = "";
      if (p.id === "bk-sumika" || p.name.includes("SUMiKA")) {
        imageBlock = `
          <svg class="w-full h-full p-2" viewBox="0 0 150 180" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="15" y="10" width="120" height="155" rx="8" fill="white" stroke="#2D2319" stroke-width="3"/>
            <circle cx="75" cy="22" r="5" fill="#f7f3e9" stroke="#2D2319" stroke-width="2"/>
            <path d="M15 90 C35 75 55 105 95 80 C115 70 130 85 135 80 L135 162 L15 162 Z" fill="#22c55e" stroke="#2d2319" stroke-width="2"/>
            <rect x="58" y="105" width="34" height="40" rx="10" fill="white" stroke="#2d2319" stroke-width="2"/>
            <circle cx="65" cy="115" r="3" fill="#2d2319"/>
            <circle cx="85" cy="132" r="4" fill="#2d2319"/>
            <ellipse cx="75" cy="118" r="10" fill="#fbcfe8" stroke="#2d2319" stroke-width="1.2"/>
            <circle cx="71" cy="118" r="1" fill="#2d2319"/>
            <circle cx="79" cy="118" r="1" fill="#2d2319"/>
            <path d="M50 110 L60 105 L56 125 Z" fill="#1d4ed8" stroke="#2d2319" stroke-width="1"/>
            <path d="M100 110 L90 105 L94 125 Z" fill="#1d4ed8" stroke="#2d2319" stroke-width="1"/>
            <path d="M58 135 H92 V142 H58 Z" fill="#de3e3e" stroke="#2d2319" stroke-width="1"/>
            <text x="75" y="55" text-anchor="middle" font-family="'Playfair Display', serif" font-weight="900" font-size="16" fill="#1d4ed8">SUMiKA</text>
            <text x="75" y="68" text-anchor="middle" font-family="'Patrick Hand', cursive" font-weight="bold" font-size="11" fill="#22c55e">Kẹo Mềm Sữa</text>
            <rect x="25" y="105" width="28" height="15" rx="3" fill="white" stroke="#22c55e" stroke-width="1"/>
            <text x="39" y="115" text-anchor="middle" font-size="7" font-weight="bold" fill="#16a34a">${p.unit.replace('gói ', '')}</text>
          </svg>
        `;
      } else if (p.imageUrl) {
        // Nếu sản phẩm từ Supabase có URL ảnh thật
        imageBlock = `<img src="${p.imageUrl}" alt="${p.name}" class="max-h-full max-w-full object-contain p-2" />`;
      } else {
        imageBlock = `<span class="text-5xl">${p.emoji || '📦'}</span>`;
      }

      card.innerHTML = `
        <div class="space-y-3">
          <div class="flex justify-between items-center">
            <span class="bg-amber-100 text-amber-800 text-[10px] px-2 py-0.5 rounded font-bold uppercase border border-amber-300">
              ${p.tag}
            </span>
            <span class="text-xs text-neutral-500 font-medium">Bán lẻ: ${p.unit}</span>
          </div>

          <div class="h-36 bg-[#f4ebd9] rounded-md flex items-center justify-center border-2 border-[#2d2319] relative overflow-hidden">
            ${imageBlock}
            <div class="absolute bottom-1 right-1 bg-neutral-900 text-[#f7f3e9] text-[9px] px-1 rounded">Sản phẩm chính hãng</div>
          </div>

          <div>
            <h4 class="font-bold text-[#2d2319] text-base line-clamp-1">${p.name}</h4>
            <p class="text-xs text-neutral-600 mt-1 line-clamp-2 min-h-[32px]">${p.desc}</p>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-dashed border-neutral-300 flex justify-between items-center">
          <div>
            <span class="text-xs text-neutral-500 block">Đơn giá:</span>
            <span class="font-bold text-red-700 text-lg">${formatVND(p.price)}</span>
          </div>
          <button data-add-id="${p.id}" class="add-to-cart-btn bg-[#f4a261] hover:bg-[#e07a5f] text-[#2d2319] p-2 rounded-lg font-bold text-xs flex items-center gap-1.5 retro-border shadow-sm transition-all active:scale-95">
            <span>Lượm đồ</span> <i class="fa-solid fa-cart-plus"></i>
          </button>
        </div>
      `;

      // Gắn sự kiện cho nút Thêm vào giỏ
      card.querySelector('.add-to-cart-btn').addEventListener('click', () => {
        addToCart(p.id);
      });

      grid.appendChild(card);
    });
  }

  // Lọc sản phẩm
  function filterProducts(category) {
    document.querySelectorAll(".cat-btn").forEach(btn => {
      btn.classList.remove("active", "bg-[#2d2319]", "text-[#f7f3e9]");
      btn.classList.add("bg-white", "text-[#2d2319]");
    });

    const activeBtn = document.getElementById(`btn-cat-${category}`);
    if (activeBtn) {
      activeBtn.classList.remove("bg-white", "text-[#2d2319]");
      activeBtn.classList.add("active", "bg-[#2d2319]", "text-[#f7f3e9]");
    }

    renderProducts(category);
  }

  // --- CART MANAGEMENT ---
  function toggleCart() {
    const drawer = document.getElementById("cart-drawer");
    const overlay = document.getElementById("cart-overlay");
    if (drawer && overlay) {
      drawer.classList.toggle("translate-x-full");
      overlay.classList.toggle("hidden");
    }
  }

  function addToCart(productId) {
    const product = products.find(p => p.id === productId);
    if (!product) return;

    const existing = cart.find(item => item.id === productId);
    if (existing) {
      existing.quantity += 1;
    } else {
      cart.push({ ...product, quantity: 1 });
    }

    saveCart();
    updateCartUI();
    showToast(`Đã thêm 1 ${product.unit} ${product.name} vào giỏ`, "success");
  }

  function updateQuantity(productId, change) {
    const item = cart.find(i => i.id === productId);
    if (!item) return;

    item.quantity += change;
    if (item.quantity <= 0) {
      cart = cart.filter(i => i.id !== productId);
    }

    saveCart();
    updateCartUI();
  }

  function clearCart() {
    cart = [];
    purchasedCandyCount = 0;
    activeDiscount = null;
    saveCart();
    updateCartUI();
    showToast("Đã dọn sạch giỏ hàng rồi bạn nhé!", "info");
  }

  function refundCandies() {
    purchasedCandyCount = 0;
    activeDiscount = null;
    updateCartUI();
    showToast("Đã hủy bỏ mua kẹo sữa may mắn!", "info");
  }

  function saveCart() {
    localStorage.setItem("mnp_cart", JSON.stringify(cart));
  }

  function loadCart() {
    const saved = localStorage.getItem("mnp_cart");
    if (saved) {
      try {
        cart = JSON.parse(saved);
      } catch (e) {
        cart = [];
      }
    }
  }

  function updateCartUI() {
    const container = document.getElementById("cart-items-container");
    const countBadge = document.getElementById("cart-count-badge");
    const totalPriceText = document.getElementById("cart-total-price");
    if (!container || !countBadge || !totalPriceText) return;

    let totalItems = 0;
    let totalPrice = 0;

    if (cart.length === 0 && purchasedCandyCount === 0) {
      container.innerHTML = `
        <div class="text-center py-16 text-[#6f5e4c]">
          <span class="text-5xl block mb-4">🧺</span>
          <p class="font-bold">Chưa có món nào hết trơn!</p>
          <p class="text-xs mt-1">Ghé gian hàng bên dưới để lựa vài món đồ nhé.</p>
        </div>
      `;
    } else {
      container.innerHTML = "";

      // Render các mặt hàng tạp hóa thường
      cart.forEach(item => {
        totalItems += item.quantity;
        totalPrice += item.price * item.quantity;

        const isSumika = item.id === "bk-sumika" || item.name.includes("SUMiKA");
        const iconDisplay = isSumika
          ? `
            <div class="w-12 h-12 bg-white flex items-center justify-center rounded border border-[#2d2319] p-0.5">
              <svg class="w-full h-full" viewBox="0 0 150 180" fill="none">
                <rect x="15" y="10" width="120" height="155" rx="8" fill="white" stroke="#2D2319" stroke-width="5"/>
                <path d="M15 90 C35 75 55 105 95 80 L135 80 L135 162 L15 162 Z" fill="#22c55e"/>
                <text x="75" y="55" text-anchor="middle" font-weight="950" font-size="20" fill="#1d4ed8">S</text>
              </svg>
            </div>
          `
          : `<div class="text-3xl bg-[#f1ebd9] p-2 rounded border border-[#2d2319] w-12 h-12 flex items-center justify-center">${item.emoji || '📦'}</div>`;

        const itemRow = document.createElement("div");
        itemRow.className = "bg-white p-3 rounded border border-neutral-300 flex items-center gap-3 relative animate-fade-in";
        itemRow.innerHTML = `
          ${iconDisplay}
          <div class="flex-1 space-y-1">
            <h5 class="font-bold text-xs text-neutral-800 leading-tight">${item.name}</h5>
            <p class="text-[11px] text-gray-500">${formatVND(item.price)} / ${item.unit}</p>
            <div class="flex items-center gap-2 mt-1">
              <button class="qty-minus w-5 h-5 bg-neutral-200 text-neutral-800 rounded flex items-center justify-center font-bold text-xs border border-neutral-400 active:scale-90">-</button>
              <span class="text-xs font-bold w-4 text-center">${item.quantity}</span>
              <button class="qty-plus w-5 h-5 bg-neutral-200 text-neutral-800 rounded flex items-center justify-center font-bold text-xs border border-neutral-400 active:scale-90">+</button>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs font-bold text-red-700 block">${formatVND(item.price * item.quantity)}</span>
            <button class="remove-item text-[10px] text-red-500 underline hover:text-red-700 mt-2">Bỏ món</button>
          </div>
        `;

        // Gắn sự kiện tăng giảm xóa
        itemRow.querySelector('.qty-minus').addEventListener('click', () => updateQuantity(item.id, -1));
        itemRow.querySelector('.qty-plus').addEventListener('click', () => updateQuantity(item.id, 1));
        itemRow.querySelector('.remove-item').addEventListener('click', () => updateQuantity(item.id, -item.quantity));

        container.appendChild(itemRow);
      });

      // Render kẹo sữa bóc lẻ từ mini-game
      if (purchasedCandyCount > 0) {
        totalItems += purchasedCandyCount;
        const candyPrice = purchasedCandyCount * 1000;
        totalPrice += candyPrice;

        const candyRow = document.createElement("div");
        candyRow.className = "bg-[#fffbeb] p-3 rounded border-2 border-[#dda15e] flex items-center gap-3 relative animate-fade-in";
        candyRow.innerHTML = `
          <div class="w-12 h-12 bg-white rounded border-2 border-[#dda15e] p-1 flex items-center justify-center">
            <svg class="w-10 h-6" viewBox="0 0 120 70" fill="none">
              <path d="M0 10 L10 15 L0 20 L10 25 L0 30 L10 35 L0 40 L10 45 L0 50 L10 55 L0 60 L15 60 L15 10 Z" fill="#15803d"/>
              <path d="M120 10 L110 15 L120 20 L110 25 L120 30 L110 35 L120 40 L110 45 L120 50 L110 55 L120 60 L105 60 L105 10 Z" fill="#15803d"/>
              <rect x="14" y="10" width="92" height="50" fill="white" stroke="#15803d" stroke-width="1.5"/>
              <path d="M14 45 Q50 35 106 48 L106 60 L14 60 Z" fill="#22c55e"/>
              <text x="24" y="32" font-weight="900" font-size="12" fill="#1d4ed8">S</text>
            </svg>
          </div>
          <div class="flex-1 space-y-1">
            <h5 class="font-bold text-xs text-amber-900 leading-tight">Kẹo sữa Sumika bóc lẻ dò số</h5>
            <p class="text-[11px] text-amber-700">1.000đ / chiếc</p>
            <div class="flex items-center gap-2 mt-1">
              <span class="text-xs bg-amber-200 text-amber-800 px-2 py-0.5 rounded font-semibold">Số lượng: ${purchasedCandyCount}</span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs font-bold text-amber-800 block">${formatVND(candyPrice)}</span>
            <button id="refund-candies-btn" class="text-[10px] text-amber-600 underline hover:text-red-700 mt-2">Xóa kẹo</button>
          </div>
        `;

        candyRow.querySelector('#refund-candies-btn').addEventListener('click', refundCandies);
        container.appendChild(candyRow);
      }
    }

    countBadge.innerText = String(totalItems);
    totalPriceText.innerText = formatVND(totalPrice);
  }

  // --- TRÒ CHƠI "BÓC KẸO SỮA - DÒ SỐ MAY MẮN" ---
  function buyAndRevealCandy() {
    if (isOpeningCandy) return;
    isOpeningCandy = true;

    const jar = document.getElementById("candy-jar");
    const hiddenDiv = document.getElementById("candy-hidden");
    const revealedDiv = document.getElementById("candy-revealed");
    const numSpan = document.getElementById("revealed-number");
    const statusP = document.getElementById("revealed-match-status");
    const gameToast = document.getElementById("candy-game-toast");

    if (!jar || !hiddenDiv || !revealedDiv || !numSpan || !statusP || !gameToast) return;

    // Hiệu ứng lắc hũ kẹo
    jar.classList.add("jar-shake");
    gameToast.innerHTML = `<span class="text-xs text-emerald-800 font-bold animate-pulse">🥛 Đang lắc hũ chọn kẹo sữa SUMiKA... chờ xíu nha!</span>`;

    setTimeout(() => {
      jar.classList.remove("jar-shake");

      // Tạo số ngẫu nhiên từ 00 đến 99
      const randNum = Math.floor(Math.random() * 100);
      const formattedNum = randNum.toString().padStart(2, "0");

      // Đổi UI sang hiển thị kết quả
      hiddenDiv.classList.add("hidden");
      revealedDiv.classList.remove("hidden");
      numSpan.innerText = formattedNum;

      // Tăng số lượng kẹo đã mua trong hóa đơn
      purchasedCandyCount += 1;
      updateCartUI();

      let prizeName = "";
      let giftName = "";
      let hasWon = false;

      // Quy tắc dò thưởng:
      if (randNum === 88) {
        prizeName = "⭐ GIẢI ĐẶC BIỆT";
        giftName = "1 Gói Kẹo Sữa SUMiKA (350g)";
        hasWon = true;
      } else if (randNum === 12 || randNum === 45) {
        prizeName = "🥇 GIẢI NHẤT";
        giftName = "1 Lon Sá Xị Chương Dương";
        hasWon = true;
      } else if ([7, 33, 67, 91].includes(randNum)) {
        prizeName = "🥈 GIẢI NHÌ";
        giftName = "1 Gói Mì Giấy Miliket";
        hasWon = true;
      } else if (formattedNum.endsWith("5") || formattedNum.endsWith("9")) {
        prizeName = "🥉 GIẢI KHUYẾN KHÍCH";
        giftName = "2 Viên Kẹo Sữa SUMiKA lẻ";
        hasWon = true;
      }

      if (hasWon) {
        activeDiscount = {
          num: formattedNum,
          prize: prizeName,
          gift: giftName,
        };

        statusP.className = "text-xs font-bold text-red-600 animate-bounce";
        statusP.innerText = `Trúng ${prizeName}! Nhận ngay ${giftName}`;
        gameToast.innerHTML = `<span class="text-xs text-red-600 font-bold">🎉 Cực đỉnh! Viên kẹo số ${formattedNum} trúng ngay ${giftName}!</span>`;
        showToast(`Kẹo Sumika số ${formattedNum} trúng thưởng: ${giftName}`, "success");
      } else {
        statusP.className = "text-xs font-bold text-gray-500";
        statusP.innerText = `Kẹo siêu béo, chúc bạn may mắn số sau!`;
        gameToast.innerHTML = `<span class="text-xs text-gray-500">Mã số ${formattedNum} chưa trúng giải. Nhưng vị kẹo sữa dẻo vẫn ngon lành cành đào!</span>`;
        showToast(`Kẹo sữa dẻo thơm nhưng số ${formattedNum} chưa trúng giải rồi!`, "info");
      }

      isOpeningCandy = false;
    }, 1000);
  }

  // --- CHECKOUT & BILL ---
  function openCheckoutModal() {
    if (cart.length === 0 && purchasedCandyCount === 0) {
      showToast("Giỏ đồ trống trơn à, tiệm chưa viết hóa đơn được bạn ơi!", "warning");
      return;
    }

    toggleCart();

    const modal = document.getElementById("checkout-modal");
    if (modal) {
      modal.classList.remove("hidden");
      updateBillUI();
    }
  }

  function closeCheckoutModal() {
    const modal = document.getElementById("checkout-modal");
    if (modal) {
      modal.classList.add("hidden");
    }
  }

  function updateBillUI() {
    const tbody = document.getElementById("bill-table-body");
    const subtotalText = document.getElementById("bill-subtotal");
    const discountRow = document.getElementById("bill-discount-row");
    const discountVal = document.getElementById("bill-discount-val");
    const totalText = document.getElementById("bill-total");

    if (!tbody || !subtotalText || !discountRow || !discountVal || !totalText) return;

    tbody.innerHTML = "";
    let subtotal = 0;

    // Nạp các mặt hàng
    cart.forEach(item => {
      const cost = item.price * item.quantity;
      subtotal += cost;

      const row = document.createElement("tr");
      row.className = "border-b border-sky-100";
      row.innerHTML = `
        <td class="py-1 max-w-[150px] truncate font-sans text-xs text-neutral-800">${item.name}</td>
        <td class="py-1 text-center font-bold font-handwritten text-lg">${item.quantity}</td>
        <td class="py-1 text-right text-xs font-sans text-neutral-600">${formatVND(item.price)}</td>
        <td class="py-1 text-right font-bold text-sky-900">${formatVND(cost)}</td>
      `;
      tbody.appendChild(row);
    });

    // Kẹo lẻ
    if (purchasedCandyCount > 0) {
      const candyCost = purchasedCandyCount * 1000;
      subtotal += candyCost;

      const candyRow = document.createElement("tr");
      candyRow.className = "border-b border-sky-100";
      candyRow.innerHTML = `
        <td class="py-1 max-w-[150px] truncate font-sans text-xs text-neutral-800">Kẹo sữa Sumika dò số</td>
        <td class="py-1 text-center font-bold font-handwritten text-lg">${purchasedCandyCount}</td>
        <td class="py-1 text-right text-xs font-sans text-neutral-600">1.000đ</td>
        <td class="py-1 text-right font-bold text-sky-900">${formatVND(candyCost)}</td>
      `;
      tbody.appendChild(candyRow);
    }

    // Quà tặng
    if (activeDiscount) {
      const giftRow = document.createElement("tr");
      giftRow.className = "border-b border-sky-100 text-emerald-800 italic font-bold";
      giftRow.innerHTML = `
        <td class="py-1 max-w-[150px] truncate font-sans text-xs text-emerald-700">[Trúng] ${activeDiscount.gift}</td>
        <td class="py-1 text-center font-bold font-handwritten text-lg">1</td>
        <td class="py-1 text-right text-xs font-sans text-emerald-600">Tặng kèm</td>
        <td class="py-1 text-right font-bold text-emerald-700">M.Phí (0đ)</td>
      `;
      tbody.appendChild(giftRow);
    }

    subtotalText.innerText = formatVND(subtotal);

    if (activeDiscount) {
      discountRow.classList.remove("hidden");
      discountVal.innerText = activeDiscount.gift;
    } else {
      discountRow.classList.add("hidden");
    }

    totalText.innerText = formatVND(subtotal);
  }

  // Thực hiện Gửi đơn hàng lên Supabase
  async function submitOrder() {
    const nameInput = document.getElementById("cust-name");
    const phoneInput = document.getElementById("cust-phone");
    const submitBtn = document.getElementById("submit-order-btn");
    const btnText = document.getElementById("submit-btn-text");

    if (!nameInput || !phoneInput || !submitBtn || !btnText) return;

    const name = nameInput.value.trim();
    const phone = phoneInput.value.trim();

    if (!name) {
      showToast("Bạn vui lòng điền Tên vào hóa đơn nhé!", "warning");
      nameInput.focus();
      return;
    }

    if (!phone) {
      showToast("Vui lòng nhập Số Điện Thoại để tiệm tiện liên hệ nhé!", "warning");
      phoneInput.focus();
      return;
    }

    // Cập nhật trạng thái loading
    submitBtn.disabled = true;
    submitBtn.classList.add("opacity-75", "cursor-wait");
    btnText.innerText = "Đang gửi đơn lên hệ thống...";

    let subtotal = 0;
    cart.forEach(item => {
      subtotal += item.price * item.quantity;
    });
    subtotal += purchasedCandyCount * 1000;

    const result = await submitOrderToSupabase({
      customerName: name,
      customerPhone: phone,
      items: cart,
      purchasedCandyCount,
      activeDiscount,
      subtotal
    });

    if (result.success) {
