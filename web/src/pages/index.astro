  function removeTypingIndicator() {
    document.getElementById("chatbot-typing")?.remove();
  }

  function renderQuickReplies(replies) {
    const container = document.getElementById("chatbot-quick-replies");
    if (!container) return;

    container.innerHTML = "";
    replies.forEach(text => {
      const btn = document.createElement("button");
      btn.className = "bg-white hover:bg-[#f4a261] text-[#2d2319] text-[11px] font-bold px-2.5 py-1 rounded-full border border-[#2d2319] transition-all active:scale-95";
      btn.textContent = text;
      btn.addEventListener("click", () => {
        handleUserInput(text);
      });
      container.appendChild(btn);
    });
  }

  function findResponse(input) {
    const normalized = input.toLowerCase().trim();

    for (const script of chatbotScripts) {
      for (const keyword of script.keywords) {
        if (normalized.includes(keyword)) {
          return script;
        }
      }
    }

    return null;
  }

  function handleUserInput(text) {
    if (!text.trim()) return;

    addUserMessage(text);
    renderQuickReplies([]);

    const input = document.getElementById("chatbot-input");
    if (input) input.value = "";

    addTypingIndicator();

    setTimeout(() => {
      removeTypingIndicator();

      const matched = findResponse(text);

      if (matched) {
        addBotMessage(matched.response);
        if (matched.quickReplies) {
          renderQuickReplies(matched.quickReplies);
        }
      } else {
        addBotMessage("Xin lỗi bạn, mình chưa hiểu câu hỏi này lắm. Bạn có thể hỏi về:\n• Sản phẩm & giá cả\n• Cách đặt hàng\n• Giờ mở cửa & địa chỉ\n• Thanh toán & giao hàng\n\nHoặc chọn câu hỏi bên dưới nha!");
        renderQuickReplies(defaultQuickReplies);
      }
    }, 600 + Math.random() * 400);
  }

  // Khởi chạy và gán các sự kiện tĩnh
  document.addEventListener("DOMContentLoaded", () => {
    // Tải giỏ hàng
    loadCart();
    updateCartUI();

    // Render danh mục sản phẩm ban đầu (từ SSR data)
    renderProducts("tat-ca");

    // Asynchronously tải lại danh mục sản phẩm mới nhất từ Serverless API phía client
    fetchProducts().then(latestProducts => {
      if (latestProducts && latestProducts.length > 0) {
        products = latestProducts;
        renderProducts("tat-ca");
      }
    });

    // Lắp ngày tháng năm hiện tại
    const today = new Date();
    const dayEl = document.getElementById("bill-day");
    const monthEl = document.getElementById("bill-month");
    if (dayEl) dayEl.innerText = String(today.getDate());
    if (monthEl) monthEl.innerText = String(today.getMonth() + 1);

    // Gắn sự kiện các nút điều khiển giỏ hàng
    document.getElementById("cart-btn")?.addEventListener("click", toggleCart);
    document.getElementById("close-cart-btn")?.addEventListener("click", toggleCart);
    document.getElementById("cart-overlay")?.addEventListener("click", toggleCart);
    document.getElementById("clear-cart-btn")?.addEventListener("click", clearCart);
    document.getElementById("open-checkout-btn")?.addEventListener("click", openCheckoutModal);

    // Bóc kẹo
    document.getElementById("buy-candy-btn")?.addEventListener("click", buyAndRevealCandy);

    // Checkout modal đóng/mở
    document.getElementById("close-checkout-btn")?.addEventListener("click", closeCheckoutModal);
    document.getElementById("cancel-checkout-btn")?.addEventListener("click", closeCheckoutModal);
    document.getElementById("submit-order-btn")?.addEventListener("click", submitOrder);

    // Bộ lọc danh mục
    document.querySelectorAll(".cat-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-cat");
        filterProducts(cat);
      });
    });

    // Các đường link lọc ở footer
    document.querySelectorAll(".filter-link").forEach(link => {
      link.addEventListener("click", () => {
        const cat = link.getAttribute("data-cat");
        filterProducts(cat);
      });
    });

    // Khởi tạo logic Khảo sát học trò
    initSurveyLogic();

    // Chatbot
    document.getElementById("chatbot-toggle")?.addEventListener("click", toggleChatbot);
    document.getElementById("chatbot-badge")?.addEventListener("click", toggleChatbot);
    document.getElementById("chatbot-close")?.addEventListener("click", toggleChatbot);
    document.getElementById("chatbot-send")?.addEventListener("click", () => {
      const input = document.getElementById("chatbot-input");
      if (input) handleUserInput(input.value);
    });
    document.getElementById("chatbot-input")?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        handleUserInput(e.target.value);
      }
    });
  });
</script>
